# Maintainer: Sonicfast contributors
pkgname=sonicfast
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Native OpenSubsonic music client"
arch=('x86_64' 'aarch64')
url="https://github.com/1800alex/sonicfast"
license=('MIT')
install="${pkgname}.install"
depends=('dbus' 'alsa-lib' 'libpipewire' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11')
makedepends=('cargo' 'cmake' 'clang')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions'
            'pipewire-pulse: PipeWire as the PulseAudio server')
conflicts=('sonicfast-bin' 'sonicfast-git')
# !lto because ring compiles its own C and Arch's default CFLAGS put LTO
# objects in the archive, which lld then cannot resolve: the link fails on
# undefined ring_core_* symbols.
options=('!debug' '!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/sonicfast-v${pkgver}-source.tar.gz")
sha256sums=('@SOURCE_SHA256@')

_source_dir() {
  printf '%s\n' "${srcdir}/sonicfast-${pkgver}"
}

prepare() {
  cd "$(_source_dir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_source_dir)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Generated bindings inside glutin carry the path they were built at, which
  # ends up in the binary and makes makepkg warn about a reference to $srcdir.
  # Appended rather than assigned, so the distro's own flags survive.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release --bin sonicfast
}

check() {
  cd "$(_source_dir)"
  export RUSTUP_TOOLCHAIN=stable
  # The demo feature carries the headless render test, which lays out every
  # page without a display and talks to nothing.
  cargo test --frozen --features demo
}

package() {
  cd "$(_source_dir)"

  install -Dm755 "target/release/sonicfast" "${pkgdir}/usr/bin/sonicfast"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "packaging/applications/sonicfast.desktop" \
    "${pkgdir}/usr/share/applications/sonicfast.desktop"
  install -Dm644 "packaging/icons/sonicfast.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/sonicfast.svg"
  # Older release fixtures predate the optional integration.
  if [[ -d contrib/omarchy ]]; then
    install -Dm644 contrib/omarchy/sonicfast.json.tpl "${pkgdir}/usr/share/sonicfast/omarchy/sonicfast.json.tpl"
    install -Dm755 contrib/omarchy/sonicfast-theme "${pkgdir}/usr/share/sonicfast/omarchy/sonicfast-theme"
  fi
}
