# Maintainer: Carmine Paolino <carmine@paolino.me>
pkgname=sonicfast-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Native OpenSubsonic music client"
arch=('x86_64' 'aarch64')
url="https://github.com/1800alex/sonicfast"
license=('MIT')
install="${pkgname}.install"
# alsa-lib and libpipewire are linked directly; the rest are dlopened by winit
# and glutin at startup, and this is a GUI-only application, so all of them
# have to be there for it to run at all.
depends=('dbus' 'alsa-lib' 'libpipewire' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11')
optdepends=('libxkbcommon-x11: keyboard handling in X11 sessions'
            'pipewire-pulse: PipeWire as the PulseAudio server')
provides=("sonicfast=$pkgver")
conflicts=('sonicfast' 'sonicfast-git')
options=('!debug' '!strip')
_repo="https://github.com/1800alex/sonicfast"
source_x86_64=("${_repo}/releases/download/v${pkgver}/sonicfast-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${_repo}/releases/download/v${pkgver}/sonicfast-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local target
  case "$CARCH" in
    x86_64) target="x86_64-unknown-linux-gnu" ;;
    aarch64) target="aarch64-unknown-linux-gnu" ;;
  esac
  local dir="${srcdir}/sonicfast-v${pkgver}-${target}"

  install -Dm755 "${dir}/sonicfast" "${pkgdir}/usr/bin/sonicfast"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/applications/sonicfast.desktop" \
    "${pkgdir}/usr/share/applications/sonicfast.desktop"
  install -Dm644 "${dir}/packaging/icons/sonicfast.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/sonicfast.svg"
  # Older release fixtures predate the optional integration.
  if [[ -d "${dir}/contrib/omarchy" ]]; then
    install -Dm644 "${dir}/contrib/omarchy/sonicfast.json.tpl" "${pkgdir}/usr/share/sonicfast/omarchy/sonicfast.json.tpl"
    install -Dm755 "${dir}/contrib/omarchy/sonicfast-theme" "${pkgdir}/usr/share/sonicfast/omarchy/sonicfast-theme"
  fi
}
